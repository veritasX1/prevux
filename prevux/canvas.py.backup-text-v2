import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")

from gi.repository import Gtk, GdkPixbuf


class ZoomCanvas(Gtk.ScrolledWindow):

    def __init__(self):

        super().__init__()

        self.set_hexpand(True)
        self.set_vexpand(True)

        self.zoom = 1.0
        self.fit_zoom = 1.0

        self.original_width = 1
        self.original_height = 1

        self.pixbuf = None

        # --------------------------------------------------
        # Fixed canvas
        # --------------------------------------------------

        self.canvas = Gtk.Fixed()

        self.set_child(self.canvas)

        # --------------------------------------------------
        # Image
        # --------------------------------------------------

        self.picture = Gtk.Picture()

        self.picture.set_can_shrink(True)

        self.canvas.put(
            self.picture,
            0,
            0,
        )

        # --------------------------------------------------
        # Text / annotation overlay
        # --------------------------------------------------

        self.overlay = Gtk.Fixed()

        self.canvas.put(
            self.overlay,
            0,
            0,
        )

    # ======================================================
    # IMAGE
    # ======================================================

    def set_pixbuf(self, pixbuf):

        self.pixbuf = pixbuf

        self.original_width = (
            pixbuf.get_width()
        )

        self.original_height = (
            pixbuf.get_height()
        )

        self.update_image()

    def set_png(self, path):

        pixbuf = GdkPixbuf.Pixbuf.new_from_file(
            path
        )

        self.set_pixbuf(pixbuf)

    # ======================================================
    # ZOOM
    # ======================================================

    def update_image(self):

        if self.pixbuf is None:
            return

        width = max(
            1,
            int(
                self.original_width
                * self.zoom
            ),
        )

        height = max(
            1,
            int(
                self.original_height
                * self.zoom
            ),
        )

        scaled = self.pixbuf.scale_simple(
            width,
            height,
            GdkPixbuf.InterpType.BILINEAR,
        )

        self.picture.set_pixbuf(
            scaled
        )

        self.picture.set_size_request(
            width,
            height,
        )

        self.overlay.set_size_request(
            width,
            height,
        )

        self.canvas.set_size_request(
            width,
            height,
        )

    def fit(self):

        if self.pixbuf is None:
            return

        allocation = self.get_allocation()

        available_width = max(
            1,
            allocation.width,
        )

        available_height = max(
            1,
            allocation.height,
        )

        horizontal_zoom = (
            available_width
            / self.original_width
        )

        vertical_zoom = (
            available_height
            / self.original_height
        )

        self.fit_zoom = min(
            horizontal_zoom,
            vertical_zoom,
        )

        self.zoom = self.fit_zoom

        self.update_image()

    def actual(self):

        self.zoom = 1.0

        self.update_image()

    def step_zoom(self, direction):

        factors = (
            1.15,
            1.30,
            1.50,
        )

        if direction > 0:

            self.zoom *= 1.15

        else:

            self.zoom /= 1.15

        self.zoom = max(
            0.05,
            min(
                self.zoom,
                20.0,
            ),
        )

        self.update_image()

    # ======================================================
    # TEXT OBJECTS
    # ======================================================

    def add_text_box(
        self,
        textbox,
        x,
        y,
    ):

        self.overlay.put(
            textbox,
            int(x),
            int(y),
        )

        textbox.set_visible(True)

        textbox.begin_edit()

    def remove_text_box(self, textbox):

        self.overlay.remove(
            textbox
        )

    def get_text_boxes(self):

        result = []

        child = self.overlay.get_first_child()

        while child is not None:

            result.append(child)

            child = child.get_next_sibling()

        return result

    # ======================================================
    # SCALE
    # ======================================================

    def image_to_canvas(
        self,
        image_x,
        image_y,
    ):

        return (
            image_x * self.zoom,
            image_y * self.zoom,
        )

    def canvas_to_image(
        self,
        canvas_x,
        canvas_y,
    ):

        if self.zoom == 0:
            return 0, 0

        return (
            canvas_x / self.zoom,
            canvas_y / self.zoom,
        )
